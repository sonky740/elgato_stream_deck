{
	"$schema": "https://schemas.elgato.com/streamdeck/plugins/manifest.json",
	"Name": "Media Controller",
	"Version": "0.1.0.0",
	"Author": "sonky",
	"Actions": [
		{
			"Name": "Now Playing",
			"UUID": "com.sonky.media-controller.now-playing",
			"Icon": "imgs/actions/now-playing/icon",
			"Tooltip": "현재 재생 중인 곡을 표시하고 제어합니다. 회전: 이전/다음 곡, 누름/터치: 재생·일시정지.",
			"Controllers": ["Encoder"],
			"Encoder": {
				"Icon": "imgs/actions/now-playing/encoder-icon",
				"layout": "layouts/now-playing.json",
				"TriggerDescription": {
					"Rotate": "이전 / 다음 곡",
					"Push": "재생 / 일시정지",
					"Touch": "재생 / 일시정지"
				}
			},
			"States": [
				{
					"Image": "imgs/actions/now-playing/key"
				}
			]
		}
	],
	"Category": "Media Controller",
	"CategoryIcon": "imgs/plugin/category-icon",
	"CodePath": "bin/plugin.js",
	"Description": "OS 미디어 세션을 통해 현재 재생 중인 곡을 표시하고 제어하는 Stream Deck + 플러그인.",
	"Icon": "imgs/plugin/marketplace",
	"SDKVersion": 3,
	"Software": {
		"MinimumVersion": "7.1"
	},
	"OS": [
		{
			"Platform": "mac",
			"MinimumVersion": "12"
		},
		{
			"Platform": "windows",
			"MinimumVersion": "10"
		}
	],
	"Nodejs": {
		"Version": "24",
		"Debug": "enabled"
	},
	"UUID": "com.sonky.media-controller"
}
