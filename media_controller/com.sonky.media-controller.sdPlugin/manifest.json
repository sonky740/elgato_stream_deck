{
  "$schema": "https://schemas.elgato.com/streamdeck/plugins/manifest.json",
  "Name": "Media Controller",
  "Version": "0.1.0.0",
  "Author": "sonky",
  "Actions": [
    {
      "Name": "Now Playing",
      "UUID": "com.sonky.media-controller.now-playing",
      "Icon": "imgs/actions/now-playing/icon",
      "Tooltip": "Shows and controls the current track. Dial: rotate = previous/next, push or touch = play/pause. Key: shows album art and title, press = play/pause.",
      "Controllers": ["Encoder", "Keypad"],
      "Encoder": {
        "Icon": "imgs/actions/now-playing/encoder-icon",
        "layout": "layouts/now-playing.json",
        "TriggerDescription": {
          "Rotate": "Previous / next track",
          "Push": "Play / pause",
          "Touch": "Play / pause"
        }
      },
      "States": [
        {
          "Image": "imgs/actions/now-playing/key"
        }
      ]
    },
    {
      "Name": "Next Track",
      "UUID": "com.sonky.media-controller.next",
      "Icon": "imgs/actions/next/icon",
      "Tooltip": "Skips to the next track.",
      "Controllers": ["Keypad"],
      "States": [
        {
          "Image": "imgs/actions/next/key"
        }
      ]
    },
    {
      "Name": "Previous Track",
      "UUID": "com.sonky.media-controller.previous",
      "Icon": "imgs/actions/previous/icon",
      "Tooltip": "Goes back to the previous track.",
      "Controllers": ["Keypad"],
      "States": [
        {
          "Image": "imgs/actions/previous/key"
        }
      ]
    }
  ],
  "Category": "Media Controller",
  "CategoryIcon": "imgs/plugin/category-icon",
  "CodePath": "bin/plugin.js",
  "Description": "Stream Deck + plugin that shows and controls the current track through the OS media session.",
  "Icon": "imgs/plugin/marketplace",
  "SDKVersion": 3,
  "Software": {
    "MinimumVersion": "7.1"
  },
  "OS": [
    {
      "Platform": "mac",
      "MinimumVersion": "12"
    },
    {
      "Platform": "windows",
      "MinimumVersion": "10"
    }
  ],
  "Nodejs": {
    "Version": "24"
  },
  "UUID": "com.sonky.media-controller"
}
