{
  "$schema": "https://schemas.elgato.com/streamdeck/plugins/manifest.json",
  "Name": "C AI Usage",
  "Version": "0.1.0.0",
  "Author": "sonky",
  "Actions": [
    {
      "Name": "Claude Usage",
      "UUID": "com.sonky.c-ai-usage.claude",
      "Icon": "imgs/actions/claude/icon",
      "Tooltip": "Shows your Claude subscription usage in two windows: 5-hour and weekly.",
      "Controllers": ["Encoder", "Keypad"],
      "Encoder": {
        "Icon": "imgs/actions/claude/encoder-icon",
        "layout": "layouts/usage.json"
      },
      "States": [
        {
          "Image": "imgs/actions/claude/key"
        }
      ],
      "PropertyInspectorPath": "ui/claude-usage.html",
      "UserTitleEnabled": false
    },
    {
      "Name": "Codex Usage",
      "UUID": "com.sonky.c-ai-usage.codex",
      "Icon": "imgs/actions/codex/icon",
      "Tooltip": "Shows your Codex subscription usage. OpenAI has returned only the weekly window since 2026-07, so the 5HR slot stays empty.",
      "Controllers": ["Encoder", "Keypad"],
      "Encoder": {
        "Icon": "imgs/actions/codex/encoder-icon",
        "layout": "layouts/usage.json"
      },
      "States": [
        {
          "Image": "imgs/actions/codex/key"
        }
      ],
      "PropertyInspectorPath": "ui/codex-usage.html",
      "UserTitleEnabled": false
    }
  ],
  "Category": "C AI Usage",
  "CategoryIcon": "imgs/plugin/category-icon",
  "CodePath": "bin/plugin.js",
  "Description": "Stream Deck + plugin that reads your Claude / Codex subscription limits from the account API and shows them as 5-hour and weekly gauges.",
  "Icon": "imgs/plugin/marketplace",
  "SDKVersion": 3,
  "Software": {
    "MinimumVersion": "7.1"
  },
  "OS": [
    {
      "Platform": "mac",
      "MinimumVersion": "12"
    },
    {
      "Platform": "windows",
      "MinimumVersion": "10"
    }
  ],
  "Nodejs": {
    "Version": "24"
  },
  "UUID": "com.sonky.c-ai-usage"
}
